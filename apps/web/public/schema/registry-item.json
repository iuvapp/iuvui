{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iuvui.com/schema/registry-item.json",
  "title": "iuvui Registry item",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "type", "dependencies", "files", "meta"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "const": "registry:ui"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "target", "content"],
        "properties": {
          "path": { "type": "string" },
          "type": { "enum": ["registry:ui", "registry:lib"] },
          "target": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["iuvui"],
      "properties": {
        "iuvui": {
          "type": "object",
          "required": [
            "schemaVersion",
            "version",
            "availability",
            "style",
            "integrity"
          ]
        }
      }
    }
  }
}
