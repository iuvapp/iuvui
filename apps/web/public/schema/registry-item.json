{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iuvui.com/schema/registry-item.json",
  "title": "iuvui Registry item",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "type", "dependencies", "files", "meta"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "const": "registry:ui"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "target", "content"],
        "properties": {
          "path": { "type": "string" },
          "type": {
            "enum": ["registry:ui", "registry:lib", "registry:file"]
          },
          "target": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["iuvui"],
      "properties": {
        "iuvui": {
          "type": "object",
          "required": [
            "schemaVersion",
            "version",
            "releaseStatus",
            "availability",
            "style",
            "provenance",
            "references",
            "integrity"
          ],
          "properties": {
            "releaseStatus": {
              "enum": ["published", "workspace-preview"]
            },
            "provenance": { "$ref": "#/$defs/canonicalProvenance" },
            "references": {
              "type": "array",
              "items": { "$ref": "#/$defs/upstreamReference" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "canonicalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "path"],
      "properties": {
        "kind": { "enum": ["independent", "derived"] },
        "repository": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "upstreamReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "component",
        "repository",
        "revision",
        "blob",
        "source",
        "path",
        "syncedAt",
        "license",
        "relationship",
        "localChanges"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "component": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "base": { "enum": ["aria", "base", "radix"] },
        "style": { "type": "string", "minLength": 1 },
        "registry": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/blob/[0-9a-f]{40}/.+$"
        },
        "path": { "type": "string", "minLength": 1 },
        "syncedAt": { "type": "string", "format": "date" },
        "license": { "type": "string", "minLength": 1 },
        "relationship": {
          "enum": ["derived", "architectural-reference"]
        },
        "localChanges": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
