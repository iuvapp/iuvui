{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iuvui",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "routes": [{ "pattern": "iuvui.com", "custom_domain": true }],
}
