{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iuvui-web",
  "compatibility_date": "2026-08-05",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "iuvui.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
