{
  "name": "@iuvui/web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --workspace-root registry:build && vite build --mode production",
    "clean": "rm -rf dist .wrangler",
    "deploy": "pnpm --workspace-root exec turbo run build --filter=@iuvui/web && wrangler deploy",
    "deploy:staging": "pnpm --workspace-root exec turbo run build --filter=@iuvui/web && node ../../scripts/ci-cloudflare-staging-deploy.mjs iuvui dist/server/wrangler.json",
    "dev": "pnpm preview:prepare && vite",
    "i18n:generate": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --strategy cookie baseLocale --emit-ts-declarations --silent",
    "lint": "eslint src vite.config.ts",
    "prelint": "pnpm i18n:generate",
    "pretest": "pnpm i18n:generate",
    "pretypecheck": "pnpm i18n:generate",
    "preview:prepare": "pnpm --workspace-root exec turbo run build --filter='@iuvui/react^...' --filter='@iuvui/styles^...'",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iuvui/react": "workspace:*",
    "@iuvui/site-ui": "workspace:*",
    "@iuvui/styles": "workspace:*",
    "@tanstack/react-router": "1.170.19",
    "@tanstack/react-start": "1.168.36",
    "fumadocs-core": "16.14.1",
    "fumadocs-ui": "16.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@inlang/paraglide-js": "2.23.1",
    "@iuvui/eslint-config": "workspace:*",
    "@iuvui/typescript-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "fumadocs-mdx": "15.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "vite": "8.2.0",
    "vitest": "latest",
    "wrangler": "4.136.3"
  }
}
