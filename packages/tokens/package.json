{
  "name": "@iuvui/tokens",
  "version": "0.0.0",
  "description": "Semantic design tokens for iuvui.",
  "license": "Apache-2.0",
  "homepage": "https://iuvui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iuv-tech/iuvui.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/iuv-tech/iuvui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@iuvui/eslint-config": "workspace:*",
    "@iuvui/typescript-config": "workspace:*",
    "tsup": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "publishConfig": {
    "access": "public"
  }
}
