{
  "name": "@iuvui/cli",
  "version": "0.0.1",
  "description": "The CLI for the iuvui React UI system.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "iuvui": "bin/iuvui.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node --check bin/iuvui.js && node --check src/config.js && node --check src/install.js && node --check src/main.js && node --check src/registry.js",
    "clean": "node -e \"process.exit(0)\"",
    "lint": "eslint bin src tests",
    "test": "node --test",
    "typecheck": "pnpm build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iuvapp/iuvui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://iuvui.com",
  "bugs": {
    "url": "https://github.com/iuvapp/iuvui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@iuvui/eslint-config": "workspace:*"
  }
}
