{
  "name": "iuvui",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible, themeable React components maintained by iuvui.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "clean": "turbo run clean",
    "consumer:check": "node scripts/verify-consumer.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "language:check": "node scripts/check-language.mjs",
    "lint": "turbo run lint",
    "pack:check": "pnpm build && node scripts/verify-pack.mjs",
    "public:check": "node scripts/verify-public-consumer.mjs",
    "release:check": "node scripts/check-release-policy.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "storybook": "pnpm --filter @iuvui/storybook storybook",
    "storybook:deploy": "pnpm --filter @iuvui/storybook run deploy",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @iuvui/storybook test:e2e",
    "typecheck": "turbo run typecheck",
    "upstream:check": "node scripts/check-upstream-provenance.mjs",
    "version-packages": "pnpm release:check && changeset version && pnpm release:check",
    "web": "pnpm --filter @iuvui/web dev",
    "web:build:dev": "pnpm --filter @iuvui/web build:dev",
    "web:build:prod": "pnpm --filter @iuvui/web build:prod",
    "web:deploy:dev": "pnpm --filter @iuvui/web deploy:dev",
    "web:deploy:prod": "pnpm --filter @iuvui/web deploy:prod"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@eslint/js": "latest",
    "@inlang/paraglide-js": "2.23.1",
    "@inlang/plugin-message-format": "4.4.1",
    "@iuvui/eslint-config": "workspace:*",
    "@iuvui/typescript-config": "workspace:*",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  }
}
